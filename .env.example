# Backend Configuration (Defaults for local development)
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Production Security Requirements (Enforced when ENVIRONMENT=production)
# SECRET_KEY: Required cryptographically random secret (min 32 chars). Default dev key will be rejected.
# SECRET_KEY=generate_with_openssl_rand_hex_32_or_longer
# CORS_ORIGINS: Required explicit HTTPS origins. Wildcard '*' and localhost are rejected in production.
# CORS_ORIGINS=https://mockinterview.ai,https://app.mockinterview.ai
# AUTH_COOKIE_SECURE: Automatically enforced to true in production (HTTPS-only cookies).

# External Services & Database Credentials (Do not commit real credentials)
# GEMINI_API_KEY=your_gemini_api_key_here
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/mock_interviewer

