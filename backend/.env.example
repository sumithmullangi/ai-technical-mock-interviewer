PROJECT_NAME="AI Technical Mock Interviewer API"
VERSION="0.1.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database URL with asyncpg driver
# Replace YOUR_PASSWORD with your local postgres user password
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/mock_interviewer
